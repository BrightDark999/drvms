# Copy these settings into /htdocs/.env on InfinityFree.
# Never commit the real database or encryption passwords.

CI_ENVIRONMENT = production

app.baseURL = 'https://drvms.freedev.app/'
app.indexPage = ''
app.appTimezone = Asia/Manila

# Find the exact MySQL hostname and database name in the InfinityFree
# Control Panel under MySQL Databases. They are not the website hostname.
database.default.hostname = sqlXXX.infinityfree.com
database.default.database = if0_42211259_drms_db
database.default.username = if0_42211259
database.default.password = REPLACE_WITH_DATABASE_PASSWORD
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Generate a unique production key; do not reuse the local development key.
encryption.key = REPLACE_WITH_A_RANDOM_PRODUCTION_KEY
